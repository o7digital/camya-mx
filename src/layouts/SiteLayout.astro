---
import DocumentHead from '../components/DocumentHead.astro';
import ContactDetails from '../components/ContactDetails.astro';
import Header from '../components/Header.astro';
import HomeHeader from '../components/HomeHeader.astro';
import Footer from '../components/Footer.astro';
import BodyExtras from '../components/BodyExtras.astro';
const { page } = Astro.props;
---
<!doctype html>
<html {...page.htmlAttributes}>
  <head><DocumentHead entries={page.head} /></head>
  <body {...page.bodyAttributes}>
    <a class="skip-to-content wpex-absolute wpex-opacity-0 wpex-no-underline" href="#content">Skip to content</a>
    <span data-ls_id="#site_top" tabindex="-1"></span>
    <div class="wpex-overflow-clip" id="outer-wrap">
      <div class="wpex-clr" id="wrap">
        {!page.home && <ContactDetails />}
        <div class="wpex-clr" id="overlay-header-wrap">
          {page.home ? <HomeHeader english={page.english} /> : <Header navigation={page.navigation} english={page.english} />}
          <slot />
        </div>
        <Footer english={page.english} home={page.home} />
      </div>
    </div>
    <BodyExtras english={page.english} />
    {page.bodyLinks.map(link => <link {...link} />)}
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
