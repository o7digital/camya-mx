entry-inner entry-inner wpex-first-mt-0 wpex-last-mb-0 wpex-clr"><div class="vcex-blog-entry-media entry-media image-filter-grayscale"><a href="/en/uncategorized/mexican-social-security-institute-administrative-facilities/" title="Mexican Social Security Institute – Administrative Facilities Labor Subcontracting"><img alt="" class="vcex-blog-entry-img wpex-align-middle" decoding="async" height="367" loading="lazy" sizes="(max-width: 779px) 100vw, 779px" src="/assets/uploads/2018/09/newlatter.jpg" srcset="/assets/uploads/2018/09/newlatter.jpg 779w, /assets/uploads/2018/09/newlatter-300x141.jpg 300w, /assets/uploads/2018/09/newlatter-768x362.jpg 768w" width="779" /></a></div><div class="vcex-blog-entry-details entry-details wpex-bordered wpex-first-mt-0 wpex-last-mb-0 wpex-clr"><h2 class="vcex-blog-entry-title entry-title wpex-text-2xl wpex-mb-5 wpex-child-inherit-color" style="color:#ca0043;font-size:20px;font-weight:600;text-transform:uppercase;"><a href="/en/uncategorized/mexican-social-security-institute-administrative-facilities/" style="color:#ca0043;">Mexican Social Security Institute – Administrative Facilities Labor Subcontracting</a></h2><div class="vcex-blog-entry-date entry-date wpex-text-sm wpex-text-3 wpex-mb-5">September 10 , 2018</div><div class="vcex-blog-entry-readmore-wrap entry-readmore-wrap wpex-my-15 wpex-clr"><a aria-label="READ MORE about Mexican Social Security Institute – Administrative Facilities Labor Subcontracting" class="theme-button flat rosy" href="/en/uncategorized/mexican-social-security-institute-administrative-facilities/" style="background:#000000;color:#d10269;">READ MORE</a></div></div></div></div><div class="vcex-blog-entry vcex-grid-item entry-has-details col-1 col post-256 entry type-post has-media cat-1 language-3 post_translations-23"><div class="vcex-blog-entry-inner entry-inner wpex-first-mt-0 wpex-last-mb-0 wpex-clr"><div class="vcex-blog-entry-media entry-media image-filter-grayscale"><a href="/en/uncategorized/anti-corruption-integrity-policies/" title="Anti-corruption – Integrity Policies"><img alt="" class="vcex-blog-entry-img wpex-align-middle" decoding="async" height="430" loading="lazy" sizes="(max-width: 750px) 100vw, 750px" src="/assets/uploads/2018/09/anticorrupcion.jpg" srcset="/assets/uploads/2018/09/anticorrupcion.jpg 750w, /assets/uploads/2018/09/anticorrupcion-300x172.jpg 300w" width="750" /></a></div><div class="vcex-blog-entry-details entry-details wpex-bordered wpex-first-mt-0 wpex-last-mb-0 wpex-clr"><h2 class="vcex-blog-entry-title entry-title wpex-text-2xl wpex-mb-5 wpex-child-inherit-color" style="color:#ca0043;font-size:20px;font-weight:600;text-transform:uppercase;"><a href="/en/uncategorized/anti-corruption-integrity-policies/" style="color:#ca0043;">Anti-corruption – Integrity Policies</a></h2><div class="vcex-blog-entry-date entry-date wpex-text-sm wpex-text-3 wpex-mb-5">July 12 , 2018</div><div class="vcex-blog-entry-readmore-wrap entry-readmore-wrap wpex-my-15 wpex-clr"><a aria-label="READ MORE about Anti-corruption – Integrity Policies" class="theme-button flat rosy" href="/en/uncategorized/anti-corruption-integrity-policies/" style="background:#000000;color:#d10269;">READ MORE</a></div></div></div></div></div></div></div></div></div></div><div class="vc_row wpb_row vc_row-fluid vc_custom_1704254911883 vc_general vc_parallax vc_parallax-content-moving wpex-vc_row-has-fill wpex-vc-reset-negative-margin wpex-vc-full-width-row wpex-vc-full-width-row--centered" data-vc-parallax="1.5" data-vc-parallax-image="/assets/uploads/2024/01/books-scaled.jpg"><div class="wpb_column vc_column_container vc_col-sm-12"><div class="vc_column-inner"><div class="wpb_wrapper"><div class="vcex-spacing wpex-w-100 wpex-clear"></div><h2 class="vc_custom_heading" style="font-size: 30px;color: #ffffff;text-align: center">WEBSITES OF INTEREST</h2><style is:inline> style="height:10px;"</style><div class="vcex-spacing wpex-w-100 wpex-clear" style="height:10px;"></div><div class="vcex