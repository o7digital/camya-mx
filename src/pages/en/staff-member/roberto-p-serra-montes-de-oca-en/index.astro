import pages from "../../../../data/pages.json";
import PageHeader from "../../../../components/PageHeader.astro";
import AccordionPanel from "../../../../components/AccordionPanel.astro";
const page = pages["/en/staff-member/roberto-p-serra-montes-de-oca-en/"];
---
<SiteLayout page={page}>
<main class="site-main wpex-clr" id="main">
<PageHeader attributes={{"class": "page-header centered-page-header has-bg-image bg-fixed wpex-bg-fixed wpex-bg-cover wpex-bg-center wpex-bg-no-repeat wpex-relative wpex-mb-40 wpex-surface-2 wpex-py-30 wpex-border-t wpex-border-b wpex-border-solid wpex-border-surface-3 wpex-text-2 wpex-text-center wpex-supports-mods"}}>
<div class="page-header-inner container">
<div class="page-header-content">
<h1 class="page-header-title wpex-block wpex-m-0 wpex-text-5xl">
<span>ROBERTO P. SERRA MONTES DE OCA</span>
</h1>
</div></div>
</PageHeader>
<div class="container wpex-clr" id="content-wrap">
<div class="content-area wpex-clr" id="primary">
<div class="site-content wpex-clr" id="content">
<div class="wpex-first-mt-0 wpex-clr" id="single-blocks">
<article class="single-content wpex-mt-20 entry wpex-clr" id="staff-single-content"><div class="wpb-content-wrapper"><div class="vc_row wpb_row vc_row-fluid"><div class="wpb_column vc_column_container vc_col-sm-6 wpex-vc_col-has-fill vc_general vc_parallax vc_parallax-content-moving" data-vc-parallax="1.5"><div class="vc_column-inner"><div class="wpb_wrapper"><style is:inline> style="height:15px;"</style><div class="vcex-spacing wpex-w-100 wpex-clear" style="height:15px;"></div><figure class="vcex-image vcex-module"><div class="vcex-image-inner wpex-relative wpex-inline-block"><img alt="" class="vcex-image-img wpex-align-middle" decoding="async" height="613" loading="lazy" sizes="(max-width: 613px) 100vw, 613px" src="/assets/uploads/2024/04/fot-roberto_2.png" srcset="/assets/uploads/2024/04/fot-roberto_2.png 613w, /assets/uploads/2024/04/fot-roberto_2-300x300.png 300w, /assets/uploads/2024/04/fot-roberto_2-150x150.png 150w" width="613" /></div></figure><style is:inline> style="height:15px;"</style><div class="vcex-spacing wpex-w-100 wpex-clear" style="height:15px;"></div><div class="vc_tta-container" data-vc-action="collapseAll"><div class="vc_general vc_tta vc_tta-accordion vc_tta-color-grey vc_tta-style-flat vc_tta-shape-rounded vc_tta-o-shape-group vc_tta-controls-align-default vc_tta-o-no-fill vc_tta-o-all-clickable"><div class="vc_tta-panels-container"><div class="vc_tta-panels"><AccordionPanel attributes={{"class": "vc_tta-panel", "data-vc-content": ".vc_tta-panel-body", "id": "1537827005111-8dc62f4a-1d9c1704323770959"}} bodyAttributes={{"class": "vc_tta-panel-body"}}><Fragment slot="heading"><div class="vc_tta-panel-heading"><h4 class="vc_tta-panel-title vc_tta-controls-icon-position-left"><a data-vc-accordion="" data-vc-container=".vc_tta-container" href="#1537827005111-8dc62f4a-1d9c1704323770959"><span class="vc_tta-title-text">Main Areas of Practice</span><i class="vc_tta-controls-icon vc_tta-controls-icon-plus"></i></a></h4></div></Fragment>
<div class="wpb_text_column wpb_content_element">
<div class="wpb_wrapper">
<ul>
<li style="text-align: justify;">Constitutional consultancy and litigation (<em>Amparo</em> Proceedings, Constitutional Disputes and Actions of Unconstitutionality).</li>
<li style="text-align: justify;">Public Contracting.</li>
<li style="text-align: justify;">Health Law.</li>
<li style="text-align: justify;">Environmental Law.</li>
<li style="text-align: justify;">Consumer Protection.</li>
<li style="text-align: justify;">Energy Law.</li>
<li style="text-align: justify;">Mining Law.</li>
<li style="text-align: justify;">Gaming and Raffles.</li>
<li style="text-align: justify;">Responsibility of Public Officials.</li>
<li style="text-align: justify;">State Liability.</li>
<li>Expropriation.</li>
<li style="text-align: justify;">Industrial Property.</li>
<li style="text-align: justify;">Agrarian Law.</li>
</ul>
</div>
</div>
</AccordionPanel><AccordionPanel attributes={{"class": "vc_tta-panel", "data-vc-content": ".vc_tta-panel-body", "id": "1537827005271-0ea9b0f8-c6dd1704323770959"}} bodyAttributes={{"class": "vc_tta-panel-body"}}><Fragment slot="heading"><div class="vc_tta-panel-heading"><h4 class="vc_tta-panel-title vc_tta-controls-icon-position-left"><a data-vc-accordion="" data-vc-container=".vc_tta-container" href="#1537827005271-0ea9b0f8-c6dd1704323770959"><span class="vc_tta-title-text">Professional Background</span><i class="vc_tta-controls-icon vc_tta-controls-icon-plus"></i></a></h4></div></Fragment>
<div class="wpb_text_column wpb_content_element">
<div class="wpb_wrapper">
<p style="text-align: justify;">He began his professional practice at Notary Public 186 in Mexico City. He was senior associate in two different periods in the Law Firm Hamdan, Manzanero y Asociados. He was associate of the administrative consultancy and litigation department in the Law Firm Creel, García-Cuellar and Müggenburg (currently Creel, García-Cuéllar, Aiza y Enríquez). He was founding partner of the Law Firm Gutiérrez Vázquez y Serra. Currently he is partner of CAMYA Abogados.</p>
</div>
</div>
</AccordionPanel><AccordionPanel attributes={{"class": "vc_tta-panel", "data-vc-content": ".vc_tta-panel-body", "id": "1537827005414-17429db0-73b01704323770959"}} bodyAttributes={{"class": "vc_tta-panel-body"}}><Fragment slot="heading"><div class="vc_tta-panel-heading"><h4 class="vc_tta-panel-title vc_tta-controls-icon-position-left"><a data-vc-accordion="" data-vc-container=".vc_tta-container" href="#1537827005414-17429db0-73b01704323770959"><span class="vc_tta-title-text">Relevant Cases</span><i class="vc_tta-controls-icon vc_tta-controls-icon-plus"></i></a></h4></div></Fragment>
<div class="wpb_text_column wpb_content_element">
<div class="wpb_wrapper">
<p style="text-align: justify;">Participated in many complex and strategic litigation cases related to public contracting, highlighting the long-term services provision contract (PPS) of the Collective Transportation System of Mexico City, as well as in underwater mining concessions, seaport and airport concessions of national and international companies.</p>
<p style="text-align: justify;">His extensive experience has led him to participate in constitutional disputes before the Supreme Court of Justice filed by Local and Municipal governments. He sponsored <em>amparo</em> proceedings regarding interconnection fees, as well as highly complex expropriation administrative proceedings. In his career, he has represented transnational pharmaceutical companies on issues of trademarks, patents and health records, as well as several transnational corporations before the Administrative and Agrarian Courts.</p>
</div>
</div>
</AccordionPanel><AccordionPanel attributes={{"class": "vc_tta-panel", "data-vc-content": ".vc_tta-panel-body", "id": "1537827005784-1cf9b91d-c1f81704323770959"}} bodyAttributes={{"class": "vc_tta-panel-body"}}><Fragment slot="heading"><div class="vc_tta-panel-heading"><h4 class="vc_tta-panel-title vc_tta-controls-icon-position-left"><a data-vc-accordion="" data-vc-container=".vc_tta-container" href="#1537827005784-1cf9b91d-c1f81704323770959"><span class="vc_tta-title-text">Social Responsibility</span><i class="vc_tta-controls-icon vc_tta-controls-icon-plus"></i></a></h4></div></Fragment>
<div class="wpb_text_column wpb_content_element">
<div class="wpb_wrapper">
<p style="text-align: justify;">He has participated in <em>pro-bono</em> activities for several Foundations and Private Assistance Institutions.</p>
</div>
</div>
</AccordionPanel><AccordionPanel attributes={{"class": "vc_tta-panel", "data-vc-content": ".vc_tta-panel-body", "id": "1537827006026-64cf3042-db031704323770959"}} bodyAttributes={{"class": "vc_tta-panel-body"}}><Fragment slot="heading"><div class="vc_tta-panel-heading"><h4 class="vc_tta-panel-title vc_tta-controls-icon-position-left"><a data-vc-accordion="" data-vc-container=".vc_tta-container" href="#1537827006026-64cf3042-db031704323770959"><span class="vc_tta-title-text">Academic Activities</span><i class="vc_tta-controls-icon vc_tta-controls-icon-plus"></i></a></h4></div></Fragment>
<div class="wpb_text_column wpb_content_element">
<div class="wpb_wrapper">
<p style="text-align: justify;">He is professor of Constitutional Proceedings II (“<em>Amparo II</em>”) at the Universidad La Salle, Mexico City campus and he has been professor of Administrative Litigation and Civil Law at the same University.</p>
<p style="text-align: justify;">He has participated as synodal at Escuela Libre de Derecho and the Universidad La Salle and collaborated in Administrative Law and <em>Amparo</em> Proceedings at the Universidad Anáhuac, Norte campus.</p>
<p style="text-align: justify;">He has given lectures of Procedural Aspects of the <em>Amparo</em> Proceedings II in the LLM level degree at the Universidad Iberoamericana, Torreón campus and for three consecutive years he has participated as a specialist speaker in “Administrative and Tax <em>Amparo</em> Proceedings” of the Diploma of <em>Amparo</em> Proceedings in the House of Legal Culture “Justice Raúl Castellano Jiménez” <em>(“Casa de la Cultura Jurídica Ministro Raúl Castellano Jiménez”)</em> of the Supreme Court of Justice in Torreón, Coahuila.</p>
</div>
</div>
</AccordionPanel><AccordionPanel attributes={{"class": "vc_tta-panel", "data-vc-content": ".vc_tta-panel-body", "id": "1537827006210-c65480be-6a311704323770959"}} bodyAttributes={{"class": "vc_tta-panel-body"}}><Fragment slot="heading"><div class="vc_tta-panel-heading"><h4 class="vc_tta-panel-title vc_tta-controls-icon-position-left"><a data-vc-accordion="" data-vc-container=".vc_tta-container" href="#1537827006210-c65480be-6a311704323770959"><span class="vc_tta-title-text">Education</span><i class="vc_tta-controls-icon vc_tta-controls-icon-plus"></i></a></h4></div></Fragment>
<div class="wpb_text_column wpb_content_element">
<div class="wpb_wrapper">
<ul>
<li style="text-align: justify;">JD degree by the Universidad La Salle, Mexico City campus awarded with meritorious average.</li>
<li style="text-align: justify;">LLM degree (Master of Laws) in Administrative Law by the Universidad Panamericana, Mexico City campus.</li>
<li style="text-align: justify;">LLM (Master of Laws) in Supranationalism Law by the Escuela Libre de Derecho.</li>
<li style="text-align: justify;">Postgraduate degree in Tax Law by the Universidad Panamericana, Mexico City campus.</li>
<li style="text-align: justify;">Diploma course in Energy Law by the Escuela Libre de Derecho.</li>
</ul>
</div>
</div>
</AccordionPanel><AccordionPanel attributes={{"class": "vc_tta-panel", "data-vc-content": ".vc_tta-panel-body", "id": "1537827006474-0d568523-65121704323770959"}} bodyAttributes={{"class": "vc_tta-panel-body"}}><Fragment slot="heading"><div class="vc_tta-panel-heading"><h4 class="vc_tta-panel-title vc_tta-controls-icon-position-left"><a data-vc-accordion="" data-vc-container=".vc_tta-container" href="#1537827006474-0d568523-65121704323770959"><span class="vc_tta-title-text">Languages</span><i class="vc_tta-controls-icon vc_tta-controls-icon-plus"></i></a></h4></div></Fragment>
<div class="wpb_text_column wpb_content_element">
<div class="wpb_wrapper">
<p>Spanish and English.</p>
</div>
</div>
</AccordionPanel></div></div></div></div><div class="vcex-module vcex-divider vcex-divider-solid vcex-divider-center wpex-mx-auto wpex-block wpex-h-0 wpex-border-b wpex-border-solid wpex-border-main" style="border-color:#ca0043;"></div><style is:inline> style="height:15px;"</style><div class="vcex-spacing wpex-w-100 wpex-clear" style="height:15px;"></div></div></div></div><div class="wpb_column vc_column_container vc_col-sm-6"><div class="vc_column-inner"><div class="wpb_wrapper"><style is:inline> style="height:150px;"</style><div class="vcex-spacing wpex-w-100 wpex-clear" style="height:150px;"></div>
<div class="wpb_text_column has-custom-color wpex-child-inherit-color wpb_content_element" style="color:#c3004f;font-size:16px;letter-spacing:var(--wpex-tracking-widest);text-transform:uppercase;">
<div class="wpb_wrapper">
<p style="text-align: center;"><strong>PARTNER</strong></p>
</div>
</div>
<style is:inline> style="height:15px;"</style><div class="vcex-spacing wpex-w-100 wpex-clear" style="height:15px;"></div>
<div class="wpb_text_column wpb_content_element">
<div class="wpb_wrapper">
<p style="text-align: center;"><a href="mailto:roberto.serra@camya.mx">roberto.serra@camya.mx</a></p>
<p style="text-align: center;">Attorney-at-Law with more than 20 years of experience acquired in important and recognized Law Firms in México. Specialist in administrative and constitutional advisory, consultancy and litigation, his specialization has focused mainly on matters related to a<em>mparo</em> proceedings in administrative matters, constitutional disputes and actions of unconstitutionality, consultancy and litigation in public contracting, health Law, environmental Law, consumer protection, energy Law, mining Law, gaming and raffles, responsibility of public officials, State liability, expropriation and industrial property. He has sponsored several complex and sensitive cases in agrarian matters.</p>
</div>
</div>
<div class="vcex-spacing wpex-w-100 wpex-clear"></div></div></div></div></div>
</div></article>
</div>
</div>
</div>
</div>
</main>
</SiteLayout>
