---
import SiteLayout from "../../../../layouts/SiteLayout.astro";
import pages from "../../../../data/pages.json";
import PageHeader from "../../../../components/PageHeader.astro";
import AccordionPanel from "../../../../components/AccordionPanel.astro";
const page = pages["/en/staff-member/maria-elisa-urban-garcia-en/"];
---
<SiteLayout page={page}>
<main class="site-main wpex-clr" id="main">
<PageHeader attributes={{"class": "page-header centered-page-header has-bg-image bg-fixed wpex-bg-fixed wpex-bg-cover wpex-bg-center wpex-bg-no-repeat wpex-relative wpex-mb-40 wpex-surface-2 wpex-py-30 wpex-border-t wpex-border-b wpex-border-solid wpex-border-surface-3 wpex-text-2 wpex-text-center wpex-supports-mods"}}>
<div class="page-header-inner container">
<div class="page-header-content">
<h1 class="page-header-title wpex-block wpex-m-0 wpex-text-5xl">
<span>MARIA ELISA URBAN GARCIA</span>
</h1>
</div></div>
</PageHeader>
<div class="container wpex-clr" id="content-wrap">
<div class="content-area wpex-clr" id="primary">
<div class="site-content wpex-clr" id="content">
<div class="wpex-first-mt-0 wpex-clr" id="single-blocks">
<article class="single-content wpex-mt-20 entry wpex-clr" id="staff-single-content"><div class="wpb-content-wrapper"><div class="vc_row wpb_row vc_row-fluid"><div class="wpb_column vc_column_container vc_col-sm-3"><div class="vc_column-inner"><div class="wpb_wrapper"><figure class="vcex-image vcex-module"><div class="vcex-image-inner wpex-relative wpex-inline-block"><img alt="" class="vcex-image-img wpex-align-middle" decoding="async" height="613" loading="lazy" sizes="(max-width: 613px) 100vw, 613px" src="/assets/uploads/2021/10/fot-maelisa.png" srcset="/assets/uploads/2021/10/fot-maelisa.png 613w, /assets/uploads/2021/10/fot-maelisa-300x300.png 300w, /assets/uploads/2021/10/fot-maelisa-150x150.png 150w" width="613" /></div></figure></div></div></div><div class="wpb_column vc_column_container vc_col-sm-9"><div class="vc_column-inner"><div class="wpb_wrapper">
<div class="wpb_text_column has-custom-color wpex-child-inherit-color wpb_content_element" style="color:#c3004f;letter-spacing:var(--wpex-tracking-widest);text-align:center;text-transform:uppercase;">
<div class="wpb_wrapper">
<p style="text-align: center;"><strong>Associate</strong></p>
</div>
</div>
<style is:inline> style="height:15px;"</style><div class="vcex-spacing wpex-w-100 wpex-clear" style="height:15px;"></div><div class="vcex-module vcex-divider vcex-divider-solid vcex-divider-center wpex-mx-auto wpex-block wpex-h-0 wpex-border-b wpex-border-solid wpex-border-main" style="border-color:#ca0043;"></div><style is:inline> style="height:15px;"</style><div class="vcex-spacing wpex-w-100 wpex-clear" style="height:15px;"></div>
<div class="wpb_text_column wpb_content_element">
<div class="wpb_wrapper">
<p style="text-align: center;"><a href="mailto:elisa.urban@camya.mx">elisa.urban@camya.mx</a></p>
<p style="text-align: center;">At CAMYA, our team is composed of passionate and specialized lawyers. With exceptional academic background and diverse experience, we take pride in offering innovative legal solutions. We are committed to being your trusted partner, providing quality services that go beyond the conventional.</p>
</div>
</div>
<div class="vcex-spacing wpex-w-100 wpex-clear"></div><div class="vc_tta-container" data-vc-action="collapseAll"><div class="vc_general vc_tta vc_tta-accordion vc_tta-color-grey vc_tta-style-flat vc_tta-shape-rounded vc_tta-o-shape-group vc_tta-controls-align-default vc_tta-o-no-fill vc_tta-o-all-clickable"><div class="vc_tta-panels-container"><div class="vc_tta-panels"><AccordionPanel attributes={{"class": "vc_tta-panel", "data-vc-content": ".vc_tta-panel-body", "id": "1648619047378-93e02563-0c521704322012155"}} bodyAttributes={{"class": "vc_tta-panel-body"}}><Fragment slot="heading"><div class="vc_tta-panel-heading"><h4 class="vc_tta-panel-title vc_tta-controls-icon-position-left"><a data-vc-accordion="" data-vc-container=".vc_tta-container" href="#1648619047378-93e02563-0c521704322012155"><span class="vc_tta-title-text">Experience</span><i class="vc_tta-controls-icon vc_tta-controls-icon-plus"></i></a></h4></div></Fragment>
<div class="wpb_text_column wpb_content_element">
<div class="wpb_wrapper">
<p style="text-align: justify;">Law Degree (LLB) (2021) by the Universidad Panamericana.</p>
<p style="text-align: justify;">Practicing in Consulting and Civil, Commercial and Family Law litigation and consultancy, mainly in matters related to controversies between shareholders, enforcement of contracts, credit titles, real estate leasing controversies, intellectual property advice and civil associations consulting.</p>
<p style="text-align: justify;">Ms. Urban previously worked in the civil and commercial litigation area at Alapisco Abogados, S.C. and in the intellectual property practice at Goodrich, Riquelme y Asociados, S.C.</p>
</div>
</div>
</AccordionPanel><AccordionPanel attributes={{"class": "vc_tta-panel", "data-vc-content": ".vc_tta-panel-body", "id": "1648619047515-ce9ba0a5-bd441704322012155"}} bodyAttributes={{"class": "vc_tta-panel-body"}}><Fragment slot="heading"><div class="vc_tta-panel-heading"><h4 class="vc_tta-panel-title vc_tta-controls-icon-position-left"><a data-vc-accordion="" data-vc-container=".vc_tta-container" href="#1648619047515-ce9ba0a5-bd441704322012155"><span class="vc_tta-title-text">Languages</span><i class="vc_tta-controls-icon vc_tta-controls-icon-plus"></i></a></h4></div></Fragment>
<div class="wpb_text_column wpb_content_element">
<div class="wpb_wrapper">
<p>Spanish and English.</p>
</div>
</div>
</AccordionPanel></div></div></div></div></div></div></div></div>
</div></article>
</div>
</div>
</div>
</div>
</main>
</SiteLayout>
