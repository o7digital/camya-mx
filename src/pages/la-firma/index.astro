<div class="wpb_text_column has-custom-color wpex-child-inherit-color wpex-max-w-100 wpex-mx-auto wpb_content_element" style="color:#000000;font-size:14px;letter-spacing:var(--wpex-tracking-widest);text-align:center;width:500px;">
