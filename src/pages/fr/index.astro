<style is:inline> style="height:50px;"</style><div class="vcex-spacing wpex-w-100 wpex-clear" style="height:50px;"></div><div class="vc_row wpb_row vc_inner vc_row-fluid"><div class="wpb_column vc_column_container vc_col-sm-2"><div class="vc_column-inner"><div class="wpb_wrapper"></div></div></div><div class="wpb_column center &#123; text-align: center &#125; vc_column_container vc_col-sm-8"><div class="vc_column-inner"><div class="wpb_wrapper">
