<style is:inline> style="height:120px;"</style><div class="vcex-spacing wpex-w-100 wpex-clear" style="height:120px;"></div></div></div></div><div class="wpb_column vc_column_container vc_col-sm-6 wpex-vc_col-has-fill"><div class="vc_column-inner vc_custom_1704236714345"><div class="wpb_wrapper"><style is:inline> style="height:300px;"</style><div class="vcex-spacing wpex-w-100 wpex-clear" style="height:300px;"></div>
