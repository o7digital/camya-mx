<div class="camya-recognition-capsule">
<span class="camya-mark camya-mark-chambers"><img alt="Chambers and Partners" height="430" src="/home-assets/chambers.jpeg" width="1600" /></span>
<span class="camya-mark camya-mark-wwl"><img alt="WWL — Who&#x27;s Who Legal (actualmente Lexology)" height="520" src="/home-assets/wwl.jpeg" width="1584" /></span>
<span class="camya-mark camya-mark-legal500"><img alt="Legal 500" height="524" src="/home-assets/legal500.jpeg" width="1600" /></span>
</div>
</div>
</section>
