---
import { siteUrl, allowIndexing } from '../data/site';
import seoPages from '../data/seo.json';
import keywordGroups from '../data/keyword-groups.json';
const { entries } = Astro.props;
const seo = seoPages[Astro.url.pathname];
if (!seo) throw new Error(`Missing SEO metadata: ${Astro.url.pathname}`);
const { title, description } = seo;
const language = Astro.url.pathname.startsWith('/en/') ? 'en' : 'es';
const keywords = keywordGroups.map(group => group[language].primary).join(', ');
const canonicalPath = seo.canonicalPath ?? Astro.url.pathname;
const controlledMeta = ['robots', 'description', 'keywords', 'og:title', 'og:description', 'og:type', 'og:url', 'og:image'];
const filteredEntries = entries.filter(entry => entry.tag !== 'title'
  && !(entry.tag === 'meta' && controlledMeta.includes(entry.attributes.name ?? entry.attributes.property))
  && !(entry.tag === 'link' && entry.attributes.rel === 'canonical'));

---
<script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-NLGGSN85"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
</script>
{filteredEntries.map(entry => <>
  {entry.tag === 'meta' && <meta {...entry.attributes} />}
  {entry.tag === 'link' && <link {...entry.attributes} href={entry.attributes.rel === "alternate" ? new URL(seoPages[entry.attributes.href]?.canonicalPath ?? entry.attributes.href, siteUrl).href : entry.attributes.href} />}
  {entry.tag === 'style' && <style is:inline {...entry.attributes} set:html={entry.text} />}
</>)}
<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={new URL(canonicalPath, siteUrl).href} />
<meta property="og:image" content={`${siteUrl}/home-assets/hero-montanas.webp`} />
<meta name="robots" content={allowIndexing ? "index,follow" : "noindex,nofollow"} />
<link rel="canonical" href={new URL(canonicalPath, siteUrl).href} />
<link href="/styles/interactions.css" rel="stylesheet" />
