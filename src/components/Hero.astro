---
const { title, description } = Astro.props;
---
<section aria-labelledby="home-title" class="camya-hero">
<img alt="" class="camya-hero-image" fetchpriority="high" height="770" src="/home-assets/hero-montanas.webp" width="2043" />
<div class="camya-hero-overlay"></div>
<div class="camya-home-container camya-hero-content">
<img alt="CAMYA Abogados" class="camya-hero-logo" height="50" src="/assets/uploads/2026/10/logoblanco_nvo.svg" width="205" />
<h1 id="home-title">{title}</h1>
<p class="camya-hero-description">{description}</p>
</div>
</section>
