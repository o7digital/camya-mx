---
const { english = false, home = false } = Astro.props;
const copy = english
  ? {name: 'Name', email: 'Email address', phone: 'Phone', company: 'Company', role: 'Position', message: 'Message', submit: 'Send message'}
  : {name: 'Nombre', email: 'Correo electrónico', phone: 'Teléfono', company: 'Empresa', role: 'Cargo', message: 'Mensaje', submit: 'Enviar mensaje'};
---
<form class="camya-contact-form" action="https://formspree.io/f/mgavbgza" method="post">
<label for="contact-name">{copy.name} <span aria-hidden="true">*</span></label>
<input id="contact-name" name="name" type="text" autocomplete="name" required="" maxlength="200" />
<label for="contact-email">{copy.email} <span aria-hidden="true">*</span></label>
<input id="contact-email" name="email" type="email" autocomplete="email" required="" maxlength="254" />
{home && <>
<label for="contact-company">{copy.company}</label>
<input id="contact-company" name="company" type="text" autocomplete="organization" maxlength="200" />
<label for="contact-role">{copy.role}</label>
<input id="contact-role" name="position" type="text" autocomplete="organization-title" maxlength="200" />
</>}
<label for="contact-phone">{copy.phone}</label>
<input id="contact-phone" name="phone" type="tel" autocomplete="tel" maxlength="50" />
<label for="contact-message">{copy.message} <span aria-hidden="true">*</span></label>
<textarea id="contact-message" name="message" rows="6" required="" maxlength="10000"></textarea>
<button class="theme-button" type="submit">{copy.submit}</button>
</form>
